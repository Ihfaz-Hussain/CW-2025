<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.comp2042.controller.HighScoreController"
      spacing="20" 
      alignment="CENTER"
      styleClass="highscore-root"
      stylesheets="@window_style.css">
    
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    
    <children>
        <!-- Title -->
        <Label text="HIGH SCORES" styleClass="highscore-title"/>
        
        <!-- High Score Entries -->
        <VBox fx:id="scoresContainer" spacing="15" alignment="CENTER"/>
        
        <!-- Back Button -->
        <Button fx:id="backButton" text="Back to Menu" styleClass="highscore-back-button"/>
    </children>
</VBox>
