<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.comp2042.controller.PlayerNameController"
      spacing="20" 
      alignment="CENTER"
      styleClass="highscore-root"
      stylesheets="@window_style.css">
    
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    
    <children>
        <!-- Title -->
        <Label text="ENTER YOUR NAME" styleClass="highscore-title"/>
        
        <!-- Instructions -->
        <Label text="Please enter your name for the high score:" styleClass="highscore-entry"/>
        
        <!-- Name Input Field -->
        <TextField fx:id="nameTextField" 
                   promptText="Your name"
                   maxWidth="200"
                   styleClass="hud-button"/>
        
        <!-- Start Button -->
        <Button fx:id="startButton" 
                text="START GAME" 
                styleClass="highscore-back-button"/>
    </children>
</VBox>
